{
  "name": "website-testing-tool",
  "version": "0.0.0",
  "description": "Windows desktop application for recording, editing, running, and debugging browser-based website tests.",
  "author": {
    "name": "Website Testing Tool Team"
  },
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite-dev.mjs",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "icon:generate": "node scripts/generate-app-icon.mjs",
    "package:win": "npm run build && electron-builder --win=nsis:x64 --win=portable:x64",
    "package:win:portable": "npm run build && electron-builder --win=portable:x64",
    "cli": "tsx src/cli/runTest.ts"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "playwright": "^1.59.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.9.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.website-testing-tool.app",
    "productName": "Website Testing Tool",
    "copyright": "Copyright © 2026 Website Testing Tool Team",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
